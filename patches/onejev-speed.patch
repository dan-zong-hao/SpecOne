+def _prep_worker_init(_worker_id: int) -> None:
+    import torch
+
+    torch.set_num_threads(4)
+
+
+def split_unit(unit, k: int):
+    """A plain ("batch", rows) unit as k contiguous chunks of near-equal rows (--fwd-split); other units unchanged.
+    Rows are rendered from their own seeds and the loss weight of a chunk is its row share of the step, so the
+    summed gradient is the micro-batch's."""
+    kind, idx = unit
+    if kind != "batch" or k <= 1 or len(idx) < 2:
+        return [unit]
+    k = min(k, len(idx))
+    n = len(idx)
+    return [(kind, idx[j * n // k:(j + 1) * n // k]) for j in range(k)]
+
